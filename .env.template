# Copy to .env and fill values needed for the voice-agent demo.

# Gemini is the default text LLM provider for demos/pipecat_voice_agent.py.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional OpenAI-compatible fallback for demos/pipecat_voice_agent.py.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional setup/runtime tuning.
MAX_JOBS=4
HF_HOME=.cache/huggingface
NLTK_DATA=.cache/nltk_data
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=
ATTN_IMPLEMENTATION=sdpa
